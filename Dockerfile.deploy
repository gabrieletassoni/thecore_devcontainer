ARG THECORE_VERSION=3
FROM gabrieletassoni/thecore-common:${THECORE_VERSION}

USER root
# Add the entrypoints
RUN mkdir -p "/bin/thecore_container"
COPY docker/entrypoint*.sh "/bin/thecore_container"
RUN chmod +x /bin/thecore_container/entrypoint*.sh

RUN mkdir -p /app/vendor/bundle

WORKDIR /app

# Install Rails dependecies
#
# Pin explicitly rather than letting `gem install bundler` float — it
# currently resolves to the same version, but pinning keeps this
# deterministic and matches Dockerfile.dev's own pin (see its comment for
# why an unpinned Bundler/RubyGems resolution is a real footgun here).
RUN gem install bundler -v 4.0.20 \
    && export BUNDLE_APP_CONFIG=/app/vendor/bundle \
    && bundle config set path /app/vendor/bundle \
    && bundle config set without development test \
    && bundle config build.nokogiri --use-system-libraries
