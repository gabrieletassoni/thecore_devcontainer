{
	"name": "Thecore Dev",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/thecore_devcontainer/",

	"initializeCommand": "mkdir -p ~/.docker && touch ~/.docker/config.json",
	"postAttachCommand": "sudo chown -R vscode:vscode ~",

	"customizations": {
		// Configure properties specific to VS Code.
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"ms-azuretools.vscode-docker",
				"misogi.ruby-rubocop",
				"rogalmic.bash-debug",
				"shakram02.bash-beautify",
				"foxundermoon.shell-format",
				"timonwong.shellcheck",
				"eamodio.gitlens",
				"github.vscode-github-actions",
				"Anthropic.claude-code"
			],
		}
	},

	"features": {
		// Add the claude cli feature to the devcontainer. This feature installs the claude cli tool and sets up the necessary environment variables for authentication.
		"ghcr.io/devcontainers-extra/features/claude-code:2": {}
	},

	// Claude Code skills come from the host's mattpocock-skills plugin (bind-mounted ~/.claude), never vendored here.
	"postCreateCommand": "bash .devcontainer/link-host-home.sh '${localEnv:USER}' && bash .devcontainer/check-plugins.sh",

	// Persist host-side Claude Code auth so it doesn't need re-authentication after every container rebuild.
	"mounts": [
		"source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
		"source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind"
	],

	"remoteUser": "vscode"
}