# ARG THECORE_VERSION
FROM ruby:3.3-bookworm

COPY os/02nocache /etc/apt/apt.conf.d/02nocache
COPY os/01_nodoc /etc/dpkg/dpkg.cfg.d/01_nodoc

# Add to the container thecore specific scripts
COPY scripts/ /usr/bin/
COPY docker /etc/thecore/docker

RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get -y dist-upgrade --no-install-recommends

RUN apt -y install --no-install-recommends \
    iputils-ping \
    poppler-utils \
    libvips-tools \
    libvips-dev \
    imagemagick \
    software-properties-common \
    build-essential \
    freetds-dev \
    libcups2-dev \
    apt \
    git \
    openssh-client \
    gnupg \
    iproute2 \
    procps \
    lsof \
    htop \
    net-tools \
    psmisc \
    wget \
    rsync \
    ca-certificates \
    unzip \
    zip \
    nano \
    vim-tiny \
    less \
    jq \
    lsb-release \
    apt-transport-https \
    dialog \
    libc6 \
    libgcc1 \
    libgssapi-krb5-2 \
    libicu-dev \
    liblttng-ust1 \
    libstdc++6 \
    zlib1g \
    locales \
    locales-all \
    sudo \
    ncdu \
    man-db \
    strace \
    libssl3 \
    gridsite-clients \
    geoip-database \
    libgirepository1.0-dev \
    smbclient

        
RUN apt autoremove -y && apt clean -y \
    && rm -rf /var/lib/apt/lists/* && rm -rf /var/cache/apt/archives \
    && rm -rf /usr/share/doc/ && rm -rf /usr/share/man/ 
    
    # && rm -rf /usr/share/locale/

ENV LC_ALL=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US.UTF-8

EXPOSE 3000
